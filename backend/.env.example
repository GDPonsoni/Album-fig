APP_ENV=dev                      # dev | test | prod
DATABASE_URL=postgresql+psycopg://album:album@localhost:5433/album
BASE_URL=http://localhost:5173   # usado nos links de e-mail e na checagem de Origin do WebSocket
# Sem SMTP_HOST os e-mails vão para o log e para /api/dev/mailbox (apenas em dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=album@example.com
