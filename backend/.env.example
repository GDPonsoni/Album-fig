APP_ENV=dev                      # dev | test | prod
DATABASE_URL=postgresql+psycopg://album:album@localhost:5433/album
BASE_URL=http://localhost:5173   # usado nos links de e-mail e na checagem de Origin do WebSocket
# Sem SMTP_HOST os e-mails vão para o log e para /api/dev/mailbox (apenas em dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=album@example.com        # remetente, também usado pela API do Brevo
# Com a chave, o e-mail sai pela API em vez de SMTP (o plano gratuito do Render bloqueia SMTP)
BREVO_API_KEY=
# Sem R2_BUCKET as imagens ficam em backend/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=                     # endereço público do bucket, sem / no final
